# GitHub personal access token (classic or fine-grained).
# Needs read access to public repos; raises rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN=

# Optional: point all clones/processes at ONE shared data directory (e.g. a separately
# cloned collector + the dev checkout). Defaults to ./data.
# FORAGER_DATA_DIR=/home/you/forager-data

# Optional: ntfy topic URL for phone push when a PR is waiting for your merge
# (scripts/wait-merge.sh). Subscribe to the same topic in the ntfy app. Keep it secret —
# anyone who knows the URL can read/post. Leave unset to disable notifications.
# NOTIFY_URL=https://ntfy.sh/forager-<your-secret-topic>
